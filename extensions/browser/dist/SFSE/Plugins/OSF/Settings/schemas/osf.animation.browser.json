  "schemaVersion": 1,
  "title": "OSF Animation Browser",
  "description": "Browser and wheel hotkeys. Configure browsing and launch preferences inside the animation browser.",
  "version": "1.5.0",
  "dependencies": {
    "osfsettings": "1.2.0",
    "osfui": "2.1.0",
    "osf.animation.engine": "1.5.0"
  },
  "groups": {
    "General - Hotkeys": []
  },
  "hotkeys": {
