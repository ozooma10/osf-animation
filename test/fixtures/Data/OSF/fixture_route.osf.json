{
  "schema": 1,
  "pack": "Overlay Route Fixture",
  "props": {
    "helmet": {
      "source": { "form": "Starfield.esm|0x0007F115" },
      "node": "C_Head"
    }
  },
  "routes": [{
    "id": "fixture.overlay.helmet",
    "stations": [
      { "id": "head" },
      { "id": "held", "layer": { "clip": "clips/route/held.af", "holdAt": 1.0, "mask": "upperBody", "mode": "override" } },
      { "id": "stowed" }
    ],
    "transitions": [
      {
        "id": "head-to-held", "from": "head", "to": "held",
        "layer": { "clip": "clips/route/head_to_held.af", "mask": "arms" },
        "reach": {
          "atFrame": 24,
          "target": { "bone": "C_Head", "translation": [0, 0, 0], "rotationDegrees": [0, 0, 0], "scale": 1 },
          "carrierBone": "R_AnimObject1",
          "primaryLimb": "rightArm",
          "secondaryLimbs": ["leftArm"],
          "tracking": "freeze-at-contact",
          "approachFrames": 12,
          "contactLeadFrames": 2,
          "contactTrailFrames": 1,
          "releaseFrames": 7,
          "maxCorrectionCm": 25,
          "maxCorrectionDegrees": 60,
          "maxResidualCm": 2,
          "maxResidualDegrees": 5
        },
        "commit": { "atFrame": 24, "marker": "fixture.helmet.hide_head" },
        "markers": [{ "atFrame": 20, "id": "fixture.helmet.moving" }],
        "props": [
          { "attachAtFrame": 18, "prop": "fixture.helmet.external", "lifetime": "external" },
          { "attachAtFrame": 24, "prop": "helmet", "lifetime": "station" }
        ],
        "sound": [{ "atFrame": 23, "spec": "$fixture,helmet" }]
      },
      {
        "id": "held-to-stowed", "from": "held", "to": "stowed",
        "interrupt": "crossfade-before-commit",
        "layer": { "clip": "clips/route/held_to_stowed.af", "mask": "upperBody" }
      },
      {
        "id": "stowed-to-held", "from": "stowed", "to": "held",
        "layer": { "clip": "clips/route/stowed_to_held.af", "mask": "upperBody" }
      }
    ]
  }]
}
