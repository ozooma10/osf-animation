{
  "schema": 1,
  "name": "fixture props registry",
  // File-level prop templates: an osf.prop.attach names one with its own `prop` id, or with `use`.
  "props": {
    "helmet": {
      "source": {
        "equippedArmor": {
          "keyword": ["ArmorTypeSpacesuitHelmet", "ArmorTypeHelmet"]
        }
      },
      "node": "R_AnimObject1",
      "rotation": [0, -90, -90],
      "scale": 0.75
    },
    // A PARTIAL template: source only. Each action supplies its own node.
    "sourceOnly": {
      "source": { "form": "Fixture.esm|0x800" }
    }
  },
  "scenes": [
    {
      // The whole point: `prop` alone resolves the template.
      "id": "test.props.ref",
      "roles": [{ "name": "player" }],
      "stages": [{
        "clips": ["Fixture/x.glb"],
        "action": [
          { "at": 0.1, "type": "osf.prop.attach", "role": "player", "prop": "helmet" },
          { "at": 0.8, "type": "osf.prop.destroy", "prop": "helmet" }
        ]
      }]
    },
    {
      // `use` escape hatch: a second instance of one template under its own runtime id.
      "id": "test.props.use",
      "roles": [{ "name": "player" }],
      "stages": [{
        "clips": ["Fixture/x.glb"],
        "action": [
          {
            "at": 0.1, "type": "osf.prop.attach", "role": "player",
            "prop": "helmet_l", "use": "helmet", "node": "L_AnimObject1"
          }
        ]
      }]
    },
    {
      // An inline `source` REPLACES the template's whole selector — it must not deep-merge into
      // an object carrying both `form` and `equippedArmor`.
      "id": "test.props.source",
      "roles": [{ "name": "player" }],
      "stages": [{
        "clips": ["Fixture/x.glb"],
        "action": [
          {
            "at": 0.1, "type": "osf.prop.attach", "role": "player", "prop": "helmet",
            "source": { "form": "Fixture.esm|0x801" }
          }
        ]
      }]
    },
    {
      // A partial template completed by the action's own node.
      "id": "test.props.partial",
      "roles": [{ "name": "player" }],
      "stages": [{
        "clips": ["Fixture/x.glb"],
        "action": [
          { "at": 0.1, "type": "osf.prop.attach", "role": "player", "prop": "sourceOnly", "node": "R_Wrist" }
        ]
      }]
    },
    {
      // A prop id matching no template is an ordinary fully-inline attach (back-compat).
      "id": "test.props.inline",
      "roles": [{ "name": "player" }],
      "stages": [{
        "clips": ["Fixture/x.glb"],
        "action": [
          {
            "at": 0.1, "type": "osf.prop.attach", "role": "player", "prop": "visor",
            "source": { "equippedArmor": { "keyword": "ArmorTypeHelmet" } },
            "node": "R_Wrist"
          }
        ]
      }]
    }
  ]
}
