{
  // File-level prop templates: an osf.prop.attach names one with its own `prop` id, or with `use`.
  // A PARTIAL template with the legacy node spelling. Its action overrides with the canonical
  // spelling, proving the two keys are one merge concept rather than independent fields.
  // The whole point: `prop` alone resolves the template.
  // `use` escape hatch: a second instance of one template under its own runtime id.
  // An inline `source` REPLACES the template's whole selector — it must not deep-merge into
  // an object carrying both `form` and `equippedArmor`.
  // A partial template completed by the action's own node.
  // A prop id matching no template is an ordinary fully-inline attach (back-compat).
  "schema": 2,
  "name": "fixture props registry",
  "props": {
    "helmet": {
      "source": {
        "equippedArmor": {
          "keyword": [
            "ArmorTypeSpacesuitHelmet",
            "ArmorTypeHelmet"
          ]
        }
      },
      "attachmentNode": "R_AnimObject1",
      "rotation": [
        0,
        -90,
        -90
      ],
      "scale": 0.75
    },
    "sourceOnly": {
      "source": {
        "form": "Fixture.esm|0x800"
      },
      "attachmentNode": "Template_Wrist"
    }
  },
  "nodes": [
    {
      "id": "test.props.ref",
      "roles": [
        {
          "name": "player"
        }
      ],
      "action": [
        {
          "at": 0.1,
          "type": "osf.prop.attach",
          "role": "player",
          "prop": "helmet"
        },
        {
          "at": 0.8,
          "type": "osf.prop.destroy",
          "prop": "helmet"
        }
      ],
      "stages": [
        {
          "clips": [
            "Fixture/x.glb"
          ]
        }
      ]
    },
    {
      "id": "test.props.use",
      "roles": [
        {
          "name": "player"
        }
      ],
      "action": [
        {
          "at": 0.1,
          "type": "osf.prop.attach",
          "role": "player",
          "prop": "helmet_l",
          "use": "helmet",
          "attachmentNode": "L_AnimObject1"
        }
      ],
      "stages": [
        {
          "clips": [
            "Fixture/x.glb"
          ]
        }
      ]
    },
    {
      "id": "test.props.source",
      "roles": [
        {
          "name": "player"
        }
      ],
      "action": [
        {
          "at": 0.1,
          "type": "osf.prop.attach",
          "role": "player",
          "prop": "helmet",
          "source": {
            "form": "Fixture.esm|0x801"
          }
        }
      ],
      "stages": [
        {
          "clips": [
            "Fixture/x.glb"
          ]
        }
      ]
    },
    {
      "id": "test.props.partial",
      "roles": [
        {
          "name": "player"
        }
      ],
      "action": [
        {
          "at": 0.1,
          "type": "osf.prop.attach",
          "role": "player",
          "prop": "sourceOnly",
          "attachmentNode": "R_Wrist"
        }
      ],
      "stages": [
        {
          "clips": [
            "Fixture/x.glb"
          ]
        }
      ]
    },
    {
      "id": "test.props.inline",
      "roles": [
        {
          "name": "player"
        }
      ],
      "action": [
        {
          "at": 0.1,
          "type": "osf.prop.attach",
