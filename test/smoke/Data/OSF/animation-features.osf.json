{
  "schema": 1,
  "name": "OSF Animation feature acceptance fixtures",
  "unlisted": true,
  "camera": "none",
  "placement": "followActor",
  "playerInputLock": false,
  "hideApparel": false,
  "clearHeldItems": false,
  "fade": false,
  "sceneControls": false,
  "roles": [{ "name": "player" }],
  "scenes": [
    {
      "id": "osf.smoke.mechanisms",
      "stages": [{ "loops": 0, "clips": ["meshes/actors/human/animations/common/cower_idle.af"],
        "action": [
          { "at": "enter", "type": "osf.control.lock" },
          { "at": "enter", "type": "osf.equipment.hide", "role": "player" }
        ]
      }]
    },
    {
      "id": "osf.smoke.additive",
      "roles": [{ "name": "player", "mask": "upperBody", "poseMode": "additive", "poseWeight": 0.25 }],
      "stages": [{ "loops": 0, "clips": ["meshes/actors/human/animations/common/cower_idle.af"] }]
    },
    {
      "id": "osf.smoke.match",
      "unlisted": false,
      "tags": ["osf-smoke-only"],
      "stages": [{ "loops": 0, "clips": ["meshes/actors/human/animations/common/cower_idle.af"] }]
    }
  ],
  "routes": [{
    "id": "osf.smoke.animated",
    "stations": [
      { "id": "idle" },
      { "id": "held", "layer": { "clip": "OSF/Smoke/head.glb", "mask": "upperBody", "holdAt": 1.0 } }
    ],
    "transitions": [
      {
        "id": "out", "from": "idle", "to": "held",
        "layer": { "clip": "OSF/Smoke/head.glb", "mask": "upperBody" },
        "commit": { "atFrame": 10, "marker": "smoke.commit" },
        "markers": [{ "atFrame": 5, "id": "smoke.marker" }],
        "props": [
          { "attachAtFrame": 3, "prop": "smoke.external", "lifetime": "external" },
          { "destroyAtFrame": 20, "prop": "smoke.external", "lifetime": "external" }
        ]
      },
      {
        "id": "back", "from": "held", "to": "idle",
        "layer": { "clip": "OSF/Smoke/head.glb", "mask": "upperBody" }
      }
    ]
  }]
}
