{
  "compilerOptions": {
    "target": "ES2018",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "octane",
    "types": ["@osfui/cli/view", "vite/client"]
  },
  "include": ["src", "tests", "osfui.config.ts", "osfui.mock.ts", "vitest.config.ts"]
}
